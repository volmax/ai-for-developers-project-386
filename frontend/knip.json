{
  "$schema": "./node_modules/knip/schema/knip.json",
  "entry": ["src/main.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "../typespec/generated/client/types.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/index.ts",
    "src/components/ui/index.ts",
    "src/components/ui/button.tsx",
    "src/components/ui/card.tsx",
    "src/lib/utils.ts",
    "src/services/sdk.ts"
  ],
  "ignoreDependencies": [
    "lucide-react",
    "postcss-load-config",
    "openapi-typescript-fetch",
    "../../typespec/generated/client/types"
  ],
  "ignoreUnresolved": ["../../typespec/generated/client/types", "openapi-typescript-fetch"]
}
